# ============================================
# BACKEND CONFIGURATION
# ============================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=intermica_db
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ============================================
# JWT CONFIGURATION
# ============================================

JWT_SECRET=your-super-secret-key-change-in-production-2024
JWT_ALGORITHM=HS256
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=2592000

# ============================================
# APPLICATION
# ============================================

APP_ENV=development
APP_NAME=Intérmica S.A.S
APP_URL=http://localhost
APP_LOG_LEVEL=debug
APP_DEBUG=true

# ============================================
# CORS - SEGURIDAD CRÍTICA
# ============================================
# NUNCA uses * en producción. Lista solo dominios confiables.
# Formato: protocolo://dominio:puerto (sin trailing slash)

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://intermica.example.com

# ============================================
# RATE LIMITING - PREVENIR ATAQUES
# ============================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

# ============================================
# SECURITY
# ============================================

BCRYPT_COST=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# ============================================
# EMAIL (Para notificaciones)
# ============================================

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_FROM=noreply@intermica.com

# ============================================
# STORAGE PATHS
# ============================================

STORAGE_PATH=/storage
PDF_STORAGE_PATH=/storage/pdfs/cuentas_cobro
QR_STORAGE_PATH=/storage/qr
UPLOAD_MAX_SIZE=5242880

# ============================================
# LOGGING
# ============================================

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_PATH=logs
