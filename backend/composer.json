{
  "name": "intermica/api",
  "description": "API RESTful PHP para Intérmica S.A.S",
  "type": "project",
  "require": {
    "php": "^8.1",
    "ext-pdo": "*",
    "ext-json": "*",
    "firebase/php-jwt": "^6.10",
    "vlucas/phpdotenv": "^5.5",
    "twig/twig": "^3.8",
    "tcpdf/tcpdf": "^6.7",
    "chillerlan/php-qrcode": "^4.3",
    "monolog/monolog": "^3.5",
    "symfony/validator": "^7.0",
    "symfony/http-foundation": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
